---
import PipelineDiagram from './PipelineDiagram.astro';
---

<section class="hero container">
  <div class="hero-content">
    <!-- Headline -->
    <h1 class="display hero-headline">
      Turning data into<br>
      <em>decisions</em><span class="hero-accent-dot" aria-hidden="true">.</span>
    </h1>

    <!-- Body -->
    <p class="hero-body">
      I'm Rajan — a data scientist and industrial engineer. I help operations
      and product teams optimize workflows, automate predictive pipelines,
      and turn complex data sets into actionable ROI.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas">
      <button
        type="button"
        class="btn btn-primary"
        data-magnetic
        data-cal-link="rajan10x/meeting-ai"
        data-cal-namespace="meeting-ai"
        data-cal-config={`{"layout":"month_view"}`}
      >
        Book a call →
      </button>
      <a href="/projects" class="btn btn-outline">
        See projects
      </a>
    </div>

    <!-- Skills strip -->
    <ul class="hero-trust" role="list">
      <li>
        <img src="https://img.icons8.com/ios-filled/40/ff6b35/python.png" alt="" width="16" height="16" class="icon" />
        <span>Python</span>
      </li>
      <li>
        <img src="https://img.icons8.com/ios-filled/40/ff6b35/database.png" alt="" width="16" height="16" class="icon" />
        <span>SQL</span>
      </li>
      <li>
        <img src="https://img.icons8.com/ios-filled/40/ff6b35/artificial-intelligence.png" alt="" width="16" height="16" class="icon" />
        <span>Machine Learning</span>
      </li>
      <li>
        <img src="https://img.icons8.com/ios-filled/40/ff6b35/flow-chart.png" alt="" width="16" height="16" class="icon" />
        <span>Optimization</span>
      </li>
    </ul>
  </div>

  <!-- Pipeline diagram — desktop only -->
  <div class="hero-cluster">
    <PipelineDiagram />
  </div>
</section>

<script>
  // Hero entrance is pure CSS (fadeUp keyframes) so the headline — the LCP
  // element — paints on first render without waiting for any JS to download.
  // No GSAP/SplitText on the critical path.
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: 56px;
    padding-top: 80px;
    padding-bottom: 80px;
    border-bottom: 1px solid var(--ink-4);
    min-height: 480px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 640px;
    min-width: 0;
  }

  /* Staggered fade-up on page load */
  @media (prefers-reduced-motion: no-preference) {
    /* Headline stays opacity:1 from first paint — transform-only rise so it
       registers as the LCP element immediately instead of after a fade. */
    .hero-headline {
      animation: heroRise 600ms ease forwards;
      animation-delay: 40ms;
    }
    .hero-body {
      opacity: 0;
      animation: fadeUp 400ms ease forwards;
      animation-delay: 100ms;
    }
    .hero-ctas {
      opacity: 0;
      animation: fadeUp 400ms ease forwards;
      animation-delay: 260ms;
    }
    .hero-trust {
      opacity: 0;
      animation: fadeUp 400ms ease forwards;
      animation-delay: 340ms;
    }
  }
  @keyframes heroRise {
    from { transform: translateY(12px); }
    to   { transform: translateY(0); }
  }

  .hero-headline {
    /* Inherits from .display in global.css */
    letter-spacing: -0.02em;
  }

  .hero-accent-dot {
    color: var(--copper);
    animation: heroDot 2.2s ease-in-out infinite;
  }
  @keyframes heroDot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  .hero-body {
    max-width: 490px;
    font-size: 15.5px;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Trust strip */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 6px;
  }

  .hero-trust li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--ink-4);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--parchment-2);
    transition: all 180ms ease;
  }

  .hero-trust li .icon {
    opacity: 0.95;
    filter: drop-shadow(0 0 6px rgba(255, 107, 53, 0.35));
    transition: transform 180ms ease;
  }

  .hero-trust li:hover {
    border-color: rgba(255, 107, 53, 0.55);
    color: var(--parchment);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.6), 0 0 18px -8px rgba(255, 107, 53, 0.35);
  }
  .hero-trust li:hover .icon {
    transform: translateY(-1px);
  }

  /* Pipeline diagram column */
  .hero-cluster {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    min-width: 0;
  }
  .hero-cluster :global(.pipeline-diagram) {
    max-width: 410px;
  }

  /* Mobile: stack, hide diagram */
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 48px;
      padding-bottom: 48px;
      min-height: unset;
      gap: 28px;
    }
    .hero-cluster { display: none; }
    .hero-content { max-width: 100%; gap: 20px; }
  }

  @media (max-width: 480px) {
    .hero-ctas { flex-direction: column; align-items: flex-start; gap: 14px; }
    .hero-trust { gap: 12px 18px; }
  }
</style>
