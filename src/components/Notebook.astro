---
// Renders a parsed notebook (see src/lib/ipynb.ts) as a readable, Jupyter-style
// document: In[n]/Out[n] gutters, syntax-highlighted code, and outputs
// (streams, DataFrame tables, images, text, errors) styled for the dark theme.
import type { Notebook } from '../lib/ipynb';

interface Props {
  notebook: Notebook;
}

const { notebook } = Astro.props;
---

<div class="notebook">
  {notebook.cells.map(cell =>
    cell.type === 'markdown' ? (
      <div class="nb-markdown" set:html={cell.inputHtml} />
    ) : (
      <div class="nb-cell">
        {cell.inputHtml && (
          <div class="nb-in">
            <span class="nb-gutter" aria-hidden="true">
              In [{cell.execCount ?? ' '}]:
            </span>
            <div class="nb-code" set:html={cell.inputHtml} />
          </div>
        )}
        {cell.outputs.length > 0 && (
          <div class="nb-out">
            <span class="nb-gutter nb-gutter--out" aria-hidden="true">
              {cell.execCount != null ? `Out[${cell.execCount}]:` : ''}
            </span>
            <div class="nb-out-body">
              {cell.outputs.map(o => (
                <div class:list={['nb-output', `nb-output--${o.kind}`]} set:html={o.html} />
              ))}
            </div>
          </div>
        )}
      </div>
    )
  )}
</div>

<style>
  .notebook {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Markdown cells */
  .nb-markdown :global(h1),
  .nb-markdown :global(h2),
  .nb-markdown :global(h3) {
    font-family: var(--font-display);
    color: var(--parchment);
    margin: 0.4em 0 0.5em;
    line-height: 1.2;
  }
  .nb-markdown :global(h1) { font-size: 28px; font-weight: 700; }
  .nb-markdown :global(h2) { font-size: 22px; font-weight: 600; }
  .nb-markdown :global(h3) { font-size: 17px; font-weight: 600; }
  .nb-markdown :global(p),
  .nb-markdown :global(li) {
    font-size: 15px;
    line-height: 1.75;
    color: var(--parchment-3);
  }
  .nb-markdown :global(ul),
  .nb-markdown :global(ol) { padding-left: 1.4em; margin: 0.6em 0; }
  .nb-markdown :global(ul) { list-style: disc; }
  .nb-markdown :global(ol) { list-style: decimal; }
  .nb-markdown :global(a) { color: var(--copper); }
  .nb-markdown :global(code) {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--ink-3);
    color: var(--parchment-2);
    padding: 2px 6px;
    border-radius: 2px;
  }

  /* Cell layout — gutter label + content */
  .nb-cell {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .nb-in,
  .nb-out {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .nb-gutter {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--parchment-4);
    text-align: right;
    padding-top: 14px;
    user-select: none;
    white-space: nowrap;
  }
  .nb-gutter--out {
    color: var(--copper);
    opacity: 0.7;
  }

  /* Code input — override Shiki's inline bg to blend with the page */
  .nb-code {
    min-width: 0;
  }
  .nb-code :global(pre.astro-code) {
    background: var(--ink) !important;
    border: 1px solid var(--ink-4);
    border-radius: 6px;
    padding: 14px 16px;
    margin: 0;
    font-size: 12.5px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .nb-code :global(pre.astro-code code) {
    font-family: var(--font-mono);
  }

  /* Outputs */
  .nb-out-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 4px;
  }

  .nb-output { min-width: 0; }

  /* NOTE: stream/text/error/table markup comes from set:html, so it is NOT
     scoped — these rules must be :global() under the scoped .notebook root. */
  .notebook :global(.nb-stream),
  .notebook :global(.nb-text),
  .notebook :global(.nb-error) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
    padding: 12px 14px;
    border-radius: 6px;
  }
  .notebook :global(.nb-stream),
  .notebook :global(.nb-text) {
    color: var(--parchment-3);
    background: var(--ink-2);
    border: 1px solid var(--ink-4);
  }
  .notebook :global(.nb-stream--err),
  .notebook :global(.nb-error) {
    color: #ffb4b4;
    background: rgb(120 30 30 / 0.18);
    border: 1px solid rgb(180 60 60 / 0.4);
  }

  /* Images (matplotlib figures) — light backing so transparent figures stay legible */
  .nb-output--image :global(img),
  .nb-output--image :global(svg) {
    max-width: 100%;
    height: auto;
    background: #fff;
    padding: 12px;
    border-radius: 6px;
    border: 1px solid var(--ink-4);
  }

  /* DataFrame / HTML tables — scroll horizontally inside the box; overflow-y
     hidden so the wide table can't leak into the page's own scroll width. */
  .notebook :global(.nb-table) {
    overflow-x: auto;
    overflow-y: hidden;
    max-width: 100%;
    border: 1px solid var(--ink-4);
    border-radius: 6px;
    background: var(--ink-2);
  }
  .notebook :global(.nb-table table) {
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--parchment-3);
    width: 100%;
  }
  .notebook :global(.nb-table th),
  .notebook :global(.nb-table td) {
    border: 1px solid var(--ink-4);
    padding: 7px 12px;
    text-align: right;
    white-space: nowrap;
  }
  .notebook :global(.nb-table thead th),
  .notebook :global(.nb-table tr th:first-child) {
    background: var(--ink-3);
    color: var(--parchment-2);
    font-weight: 600;
  }
  .notebook :global(.nb-table tbody tr:hover) {
    background: var(--ink-3);
  }

  /* Mobile — drop the gutter column, stack labels inline */
  @media (max-width: 640px) {
    .nb-in,
    .nb-out {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .nb-gutter {
      text-align: left;
      padding-top: 0;
    }
  }
</style>
