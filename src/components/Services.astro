---
const services = [
  {
    name: 'Data Science',
    desc: 'Predictive and causal models — churn, LTV, demand forecasting, and lead scoring. From feature engineering in Python to models that ship, get monitored, and are retrained on new data.',
    icon: 'artificial-intelligence',
  },
  {
    name: 'Data Analytics',
    desc: 'SQL-first analysis and dashboards that answer the actual question. Turning raw warehouse tables into clean metrics, cohorts, and the insight leadership acts on.',
    icon: 'combo-chart',
  },
  {
    name: 'Decision Science',
    desc: 'Optimization and experimentation — pricing, budget allocation, routing, and A/B testing. Framing the decision first, then building the model that makes it.',
    icon: 'flow-chart',
  },
];
---

<div class="services-grid" data-reveal-group>
  {services.map(s => (
    <div class="service-card accent-top" data-spotlight>
      <div class="service-icon">
        <img
          src={`https://img.icons8.com/ios-filled/40/ff6b35/${s.icon}.png`}
          alt=""
          width="22"
          height="22"
        />
      </div>
      <h3 class="service-name">{s.name}</h3>
      <p class="service-desc">{s.desc}</p>
    </div>
  ))}
</div>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background-color: var(--ink-2);
    border: 1px solid var(--ink-4);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 107, 53, 0.45);
    box-shadow: var(--shadow-md), 0 0 28px -6px rgba(255, 107, 53, 0.18);
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: linear-gradient(180deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--ink-4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    margin-bottom: 12px;
    transition: all 200ms ease;
  }
  .service-card:hover .service-icon {
    background: rgba(255, 107, 53, 0.12);
    border-color: var(--copper);
    box-shadow: 0 0 18px -6px rgba(255, 107, 53, 0.4);
  }

  .service-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--parchment);
  }

  .service-desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--parchment-3);
    flex-grow: 1;
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .service-card { padding: 24px; }
  }
</style>
