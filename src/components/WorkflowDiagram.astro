---
// Data-driven flow diagram: source → orchestration → logic → output.
//
// Renders a real, readable pipeline from a Workflow definition (see
// src/lib/workflows.ts) instead of an abstract render. Horizontal on wide
// screens, stacks vertically in cards and on mobile. The whole figure is
// exposed to assistive tech as a single labelled image; connectors are
// decorative.
import type { Workflow } from '../lib/workflows';

interface Props {
  workflow: Workflow;
  /** Compact card variant — always stacks vertically, smaller type. */
  compact?: boolean;
  /** Render the visible <figcaption>. Off inside cards. */
  showCaption?: boolean;
}

const { workflow, compact = false, showCaption = !compact } = Astro.props;

const flow = workflow.steps.map(s => s.label).join(' → ');
const ariaLabel = `Workflow diagram: ${flow}. ${workflow.caption}`;
---

<figure class:list={['wf-figure', { 'wf-figure--compact': compact }]}>
  <div
    class:list={['wf', { 'wf--compact': compact }]}
    role="img"
    aria-label={ariaLabel}
  >
    {workflow.steps.map((step, i) => (
      <>
        <div class:list={['wf-node', { 'wf-node--hl': step.highlight }]}>
          <span class="wf-node-meta">{step.meta}</span>
          <span class="wf-node-label">{step.label}</span>
        </div>
        {i < workflow.steps.length - 1 && (
          <span class="wf-arrow" aria-hidden="true">→</span>
        )}
      </>
    ))}
  </div>

  {showCaption && <figcaption class="wf-caption">{workflow.caption}</figcaption>}
</figure>

<style>
  .wf-figure {
    margin: 0;
  }

  .wf {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    background: var(--ink);
    background-image:
      linear-gradient(to right, rgb(219 229 225 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(219 229 225 / 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--ink-4);
    border-radius: 8px;
  }

  .wf-node {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    padding: 10px 14px;
    min-width: 0;
    background: var(--ink-3);
    border: 1px solid var(--ink-4);
    border-radius: 4px;
    box-shadow: var(--shadow-sm);
  }

  .wf-node-meta {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--parchment-4);
  }

  .wf-node-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.2px;
    color: var(--parchment-2);
    white-space: nowrap;
  }

  /* Engine node — the automation core */
  .wf-node--hl {
    background: var(--copper);
    border-color: var(--copper);
  }
  .wf-node--hl .wf-node-meta { color: rgb(12 21 19 / 0.7); }
  .wf-node--hl .wf-node-label { color: var(--ink); font-weight: 600; }

  .wf-arrow {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1;
    color: var(--copper);
    opacity: 0.7;
  }

  .wf-caption {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--parchment-4);
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
  }

  /* Compact (card) — always vertical, tighter */
  .wf--compact {
    flex-direction: column;
    align-items: stretch;
    gap: 7px;
    padding: 18px;
    border: none;
    border-radius: 0;
    background-color: var(--ink-2);
    height: 100%;
  }
  .wf--compact .wf-node {
    padding: 8px 12px;
    box-shadow: none;
  }
  .wf--compact .wf-node-label { white-space: normal; }
  .wf--compact .wf-arrow {
    justify-content: center;
    transform: rotate(90deg);
    font-size: 13px;
  }

  /* Full diagram collapses to vertical on narrow viewports */
  @media (max-width: 720px) {
    .wf:not(.wf--compact) {
      flex-direction: column;
      align-items: stretch;
    }
    .wf:not(.wf--compact) .wf-node-label { white-space: normal; }
    .wf:not(.wf--compact) .wf-arrow {
      justify-content: center;
      transform: rotate(90deg);
    }
  }
</style>
