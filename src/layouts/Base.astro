---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;   // absolute URL or path — used for og:image
  imageAlt?:    string;
  type?:        'website' | 'article';
  publishedAt?: Date;
  tags?:        string[];
}

const {
  title       = 'Rajan Shrestha — Data Science, Analytics & Decision Science',
  description = 'Data scientist working across data science, analytics, and decision science with Python, SQL, machine learning, and optimization — predictive models, SQL analytics, and optimization systems that turn data into decisions.',
  image,
  imageAlt    = 'Rajan Shrestha — Data Scientist · Analytics · Decision Science',
  type        = 'website',
  publishedAt,
  tags        = [],
} = Astro.props;

const siteUrl   = Astro.site ?? new URL('https://rajanbuilds.com');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage   = image
  ? (image.startsWith('http') ? image : new URL(image, siteUrl).href)
  : new URL('/og/default.png', siteUrl).href;

// Global structured data: Person + WebSite, linked via @graph so answer
// engines can resolve "who" and "what site" from a single stable node.
const personId  = new URL('/about#person', siteUrl).href;
const websiteId = `${siteUrl.href}#website`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id':   personId,
      name:    'Rajan Shrestha',
      url:     new URL('/about/', siteUrl).href,
      jobTitle: 'Data Scientist',
      description:
        'Industrial engineer turned data scientist. Works across data science, data analytics, and decision science with Python, SQL, machine learning, and optimization.',
      knowsAbout: [
        'Data Science', 'Data Analytics', 'Decision Science',
        'Python', 'SQL', 'Machine Learning', 'Optimization',
        'PostgreSQL', 'pandas', 'scikit-learn', 'Statistics',
        'Predictive Modeling', 'Operations Research', 'A/B Testing', 'Forecasting',
      ],
      sameAs: [
        'https://www.linkedin.com/in/rajan10x/',
        'https://github.com/rajanshresth',
      ],
    },
    {
      '@type':     'WebSite',
      '@id':       websiteId,
      name:        'Rajan Shrestha',
      url:         siteUrl.href,
      description: 'Data science, data analytics, and decision science with Python, SQL, machine learning, and optimization.',
      author:      { '@id': personId },
      publisher:   { '@id': personId },
      inLanguage:  'en',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#252422" />
    <meta name="color-scheme" content="dark" />

    <!-- Content Security Policy — allowlists exactly the origins used:
         Google Fonts, icons8, Google Analytics, Cal.com, and remote images
         (data: for embedded notebook figures, https: for README assets). -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://app.cal.com; connect-src 'self' https://app.cal.com https://*.cal.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://app.cal.com https://*.cal.com; upgrade-insecure-requests"
    />

    <link rel="canonical" href={canonical} />

    <!-- Flag JS support before paint, so scroll-reveal CSS only hides
         content when the motion script is actually going to run it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Rajan Shrestha" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Rajan Shrestha" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Article-specific Open Graph -->
    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {type === 'article' && tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/og/default.png" />

    <!-- Structured data: WebSite + Person -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://img.icons8.com" />

    <!-- Libre Baskerville (display + body) + JetBrains Mono (labels, code) via
         Google Fonts — loaded non-render-blocking (media swap) so first paint
         isn't held up by the font request. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Google Analytics (GA4) -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FCVD33YW3D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FCVD33YW3D');
    </script>

    <slot name="head" />

    <!-- Cal floating-popup embed code begins -->
    <script type="text/javascript">
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "meeting-ai", {origin:"https://app.cal.com"});
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;

      Cal.ns["meeting-ai"]("floatingButton", {"calLink":"rajan10x/meeting-ai","config":{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}});
      Cal.ns["meeting-ai"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
    </script>
    <!-- Cal floating-popup embed code ends -->
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
