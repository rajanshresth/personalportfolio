---
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ?? new URL('https://rajanbuilds.com');
const canonical = new URL('/404', siteUrl).href;
---

<Base
  title="404 — Page not found · Rajan Shrestha"
  description="This page doesn’t exist or has moved. Head back to the homepage to explore data science, analytics, and decision science work."
  robots="noindex, follow"
>
  <script slot="head" type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type':    'WebPage',
      name:       '404 — Page not found',
      url:        canonical,
      isPartOf:   { '@id': `${siteUrl.href}#website` },
    })}
  </script>

  <div class="container notfound">
    <p class="notfound-code" data-reveal>404</p>
    <h1 class="notfound-title" data-reveal>That model didn’t converge.</h1>
    <p class="notfound-lede" data-reveal>
      The page you’re after doesn’t exist or has moved. No false positives here —
      let’s route you back somewhere useful.
    </p>
    <div class="notfound-actions" data-reveal>
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/projects" class="btn btn-secondary">View projects</a>
      <a href="/about" class="btn btn-ghost">About me</a>
    </div>
  </div>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 96px;
    padding-bottom: 112px;
  }

  .notfound-code {
    font-family: var(--font-display);
    font-size: clamp(72px, 16vw, 160px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 2px var(--copper);
    text-shadow: 0 0 60px -18px var(--copper-glow);
    margin-bottom: 8px;
  }

  .notfound-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 700;
    color: var(--parchment);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .notfound-lede {
    font-size: 16px;
    max-width: 480px;
    color: var(--parchment-3);
    margin-bottom: 32px;
  }

  .notfound-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  @media (max-width: 600px) {
    .notfound {
      padding-top: 64px;
      padding-bottom: 80px;
    }
  }
</style>