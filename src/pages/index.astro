---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ToolsMarquee from '../components/ToolsMarquee.astro';
import Services from '../components/Services.astro';
import { getEntry } from 'astro:content';

const featuredWork = await getEntry('work', 'capacity-based-pricing-engine');
const featuredSlug = featuredWork?.id.replace(/\.md$/, '');

const siteUrl = Astro.site ?? new URL('https://rajanbuilds.com');

// ProfessionalService — tells answer engines who offers what, to whom.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type':    'ProfessionalService',
  name:       'Rajan Shrestha — AI & Automation Consulting',
  url:        siteUrl.href,
  description:
    'Fixed-price n8n, Python, and Docker automation builds for GTM, RevOps, and supply chain & logistics teams — pricing engines, lead routing, ad allocation, route optimization, and ops dashboards.',
  provider: { '@id': new URL('/about#person', siteUrl).href },
  areaServed: 'Worldwide',
  serviceType: 'Business process automation',
  knowsAbout: ['n8n', 'Python', 'Docker', 'GTM Automation', 'RevOps', 'Supply Chain & Logistics'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name:    'Automation engagements',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Fixed-Price Automation Build' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Monthly Optimization Retainer' } },
    ],
  },
};

// Answer-first FAQ — single source of truth for the visible section and
// the FAQPage schema (answer engines favor visible text that matches JSON-LD).
const faqs = [
  {
    q: 'Who is Rajan Shrestha?',
    a: 'Rajan Shrestha is an AI & automation consultant and industrial engineer who builds n8n, Python, and Docker systems for GTM, RevOps, and supply chain & logistics teams. He specializes in connecting a company’s existing tools so data entry happens once and downstream steps run without a human in the loop.',
  },
  {
    q: 'What does Rajan build?',
    a: 'Automation systems that replace manual, repetitive operations — capacity-based pricing engines, lead routing and follow-up, ad-budget allocation, route optimization, and cross-tool ops dashboards. Each is designed as architecture that runs continuously rather than a one-off script.',
  },
  {
    q: 'What tools and technologies does he use?',
    a: 'n8n for orchestration, Python for custom logic like scoring and optimization, and Docker so each system can be deployed on a client’s own infrastructure. The wider stack includes PostgreSQL, LangChain, TypeScript, and AWS.',
  },
  {
    q: 'How much does an automation build cost?',
    a: 'Every engagement starts as a fixed-price build. The exact number depends on the number of integrations, whether the logic needs custom Python, and how much data needs migrating — you get a firm quote after a short scoping call, not an hourly estimate. Most clients then add an optional monthly retainer for ongoing optimization.',
  },
  {
    q: 'Which industries does he work with?',
    a: 'Go-to-market (GTM), revenue operations (RevOps), and supply chain & logistics — areas where the automation patterns repeat, such as pricing logic, lead routing, ops reporting, and route optimization.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type':    'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type':          'Question',
    name:             f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <Hero />

  <!-- Tech stack strip -->
  <ToolsMarquee />

  <!-- Core Competencies -->
  <section class="section container" aria-labelledby="services-heading">
    <div class="section-header" data-reveal>
      <div>
        <h2 id="services-heading">Core Competencies</h2>
        <div class="section-underline" aria-hidden="true"></div>
      </div>
    </div>
    <Services />
  </section>

  <!-- Featured case study -->
  {featuredWork && (
    <section class="section container featured-case" aria-labelledby="featured-heading">
      <div class="featured-eyebrow-row" data-reveal>
        <span class="label featured-eyebrow">Featured case study</span>
        <div class="featured-divider" aria-hidden="true"></div>
      </div>

      <div class="featured-grid">
        <div class="featured-copy" data-reveal>
          <h2 id="featured-heading">Dynamic Capacity-Based Pricing Engine</h2>
          <p>
            A logistics client needed to adjust quotes based on real-time fleet
            capacity and market rates. I engineered a solution using Python for
            the pricing logic, orchestrated by n8n, and deployed via Docker.
          </p>

          <ul class="featured-results" role="list">
            <li>
              <img src="https://img.icons8.com/ios-filled/40/d5ffee/checkmark.png" alt="" width="16" height="16" class="icon" />
              <div>
                <span class="featured-result-label">Latency</span>
                <span class="featured-result-desc">Reduced quote generation time from 15 minutes to &lt;2 seconds.</span>
              </div>
            </li>
            <li>
              <img src="https://img.icons8.com/ios-filled/40/d5ffee/checkmark.png" alt="" width="16" height="16" class="icon" />
              <div>
                <span class="featured-result-label">Margin Protection</span>
                <span class="featured-result-desc">Automated rules prevented underpriced bookings during peak demand.</span>
              </div>
            </li>
          </ul>

          <a href={`/work/${featuredSlug}`} class="btn btn-secondary">
            Read full technical breakdown
          </a>
        </div>

        <div class="featured-code" data-reveal>
          <div class="code-block">
            <div class="code-block-header">
              <span>pricing_engine.py</span>
            </div>
            <pre><code><span class="tok-kw">def</span> <span class="tok-fn">calculate_dynamic_rate</span>(base_rate, current_capacity, market_multiplier):
    <span class="tok-str">"""Calculates the final rate based on real-time capacity."""</span>
    <span class="tok-kw">if</span> current_capacity <span class="tok-op">&lt;</span> <span class="tok-num">0.2</span>:
        <span class="tok-cm"># Critical capacity threshold</span>
        surge_factor <span class="tok-op">=</span> <span class="tok-num">1.5</span>
    <span class="tok-kw">elif</span> current_capacity <span class="tok-op">&lt;</span> <span class="tok-num">0.5</span>:
        surge_factor <span class="tok-op">=</span> <span class="tok-num">1.2</span>
    <span class="tok-kw">else</span>:
        surge_factor <span class="tok-op">=</span> <span class="tok-num">1.0</span>

    final_rate <span class="tok-op">=</span> base_rate <span class="tok-op">*</span> surge_factor <span class="tok-op">*</span> market_multiplier
    <span class="tok-kw">return</span> <span class="tok-bi">round</span>(final_rate, <span class="tok-num">2</span>)</code></pre>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ — answer-first, mirrored by FAQPage schema -->
  <section class="section container home-faq" aria-labelledby="faq-heading">
    <div class="section-header" data-reveal>
      <div>
        <h2 id="faq-heading">Frequently asked questions</h2>
        <div class="section-underline" aria-hidden="true"></div>
      </div>
    </div>
    <dl class="home-faq-list">
      {faqs.map(faq => (
        <div class="home-faq-item" data-reveal>
          <dt>{faq.q}</dt>
          <dd>{faq.a}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
  }

  /* Featured case study */
  .featured-case {
    background: var(--ink-2);
    border-radius: 8px;
    border: 1px solid var(--ink-4);
    padding: 48px var(--pad);
  }

  .featured-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .featured-eyebrow {
    color: var(--copper);
    flex-shrink: 0;
  }

  .featured-divider {
    height: 1px;
    background: var(--ink-4);
    flex-grow: 1;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }

  .featured-copy,
  .featured-code {
    min-width: 0;
  }

  .featured-copy h2 {
    margin-bottom: 16px;
  }

  .featured-copy p {
    font-size: 15px;
    margin-bottom: 24px;
  }

  .featured-results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .featured-results li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .featured-results .icon {
    margin-top: 3px;
    flex-shrink: 0;
  }

  .featured-result-label {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--parchment);
    font-size: 14px;
    margin-bottom: 2px;
  }

  .featured-result-desc {
    display: block;
    font-size: 13px;
    color: var(--parchment-3);
    line-height: 1.6;
  }

  .code-block {
    background: var(--ink);
    border: 1px solid var(--ink-4);
    border-radius: 6px;
    padding: 16px;
    overflow-x: auto;
    max-width: 100%;
    min-width: 0;
  }

  .code-block-header {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--parchment-4);
    border-bottom: 1px solid var(--ink-4);
    padding-bottom: 12px;
    margin-bottom: 16px;
  }

  .code-block pre {
    margin: 0;
  }

  .code-block code {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--parchment-3);
    white-space: pre;
  }

  .code-block :global(.tok-kw)  { color: #c678dd; }
  .code-block :global(.tok-fn)  { color: #61afef; }
  .code-block :global(.tok-str) { color: #5c6370; }
  .code-block :global(.tok-cm)  { color: #5c6370; }
  .code-block :global(.tok-op)  { color: #56b6c2; }
  .code-block :global(.tok-num) { color: #d19a66; }
  .code-block :global(.tok-bi)  { color: #e5c07b; }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .featured-case {
      padding: 32px 20px;
    }
  }

  /* FAQ */
  .home-faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 48px;
  }

  .home-faq-item dt {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--parchment);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .home-faq-item dd {
    font-size: 14px;
    line-height: 1.7;
    color: var(--parchment-3);
    max-width: 60ch;
  }

  @media (max-width: 767px) {
    .home-faq-list {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
