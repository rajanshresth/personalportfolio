---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ToolsMarquee from '../components/ToolsMarquee.astro';
import Services from '../components/Services.astro';

const siteUrl = Astro.site ?? new URL('https://rajanbuilds.com');

// ProfessionalService — tells answer engines who offers what, to whom.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type':    'ProfessionalService',
  name:       'Rajan Shrestha — Data Science, Analytics & Decision Science',
  url:        siteUrl.href,
  description:
    'Data science, data analytics, and decision science with Python, SQL, machine learning, and optimization — predictive models, SQL analytics and dashboards, pricing and budget optimization, and forecasting.',
  provider: { '@id': new URL('/about#person', siteUrl).href },
  areaServed: 'Worldwide',
  serviceType: 'Data science and analytics',
  knowsAbout: ['Data Science', 'Data Analytics', 'Decision Science', 'Python', 'SQL', 'Machine Learning', 'Optimization'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name:    'Data science engagements',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Data Science / Analytics Project' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Ongoing Analytics Retainer' } },
    ],
  },
};

// Answer-first FAQ — single source of truth for the visible section and
// the FAQPage schema (answer engines favor visible text that matches JSON-LD).
const faqs = [
  {
    q: 'Who is Rajan Shrestha?',
    a: 'Rajan Shrestha is a data scientist and industrial engineer working across data science, data analytics, and decision science. He uses Python, SQL, machine learning, and optimization to turn business data into models, analysis, and decisions teams can act on.',
  },
  {
    q: 'What does Rajan build?',
    a: 'Predictive and causal models (churn, LTV, demand forecasting, lead scoring), SQL analytics and dashboards, and decision-science systems — pricing optimization, marketing-budget allocation, and route optimization. Each project is built to ship and be maintained, not left as a one-off notebook.',
  },
  {
    q: 'What tools and technologies does he use?',
    a: 'Python (pandas, scikit-learn, XGBoost, statsmodels) for modeling, SQL and PostgreSQL for analytics, optimization libraries like OR-Tools and PuLP/SciPy for decision problems, and Tableau / Power BI for visualization. dbt for the metric layer.',
  },
  {
    q: 'What is the difference between data science, analytics, and decision science?',
    a: 'Data analytics explains and measures what happened; data science predicts what will happen; decision science optimizes what to do about it. Rajan works across all three so the answer doesn’t stop at a chart — it ends in a decision.',
  },
  {
    q: 'What kinds of problems does he work on?',
    a: 'Pricing, marketing spend, logistics, revenue and operations — anywhere a decision can be framed as a model. If the problem looks like one of the projects, it is probably a fit.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type':    'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type':          'Question',
    name:             f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <Hero />

  <!-- Tech stack strip -->
  <ToolsMarquee />

  <!-- Core Competencies -->
  <section class="section container" aria-labelledby="services-heading">
    <div class="section-header" data-reveal>
      <div>
        <h2 id="services-heading">Core Competencies</h2>
        <div class="section-underline" aria-hidden="true"></div>
      </div>
    </div>
    <Services />
  </section>

  <!-- FAQ — answer-first, mirrored by FAQPage schema -->
  <section class="section container home-faq" aria-labelledby="faq-heading">
    <div class="section-header" data-reveal>
      <div>
        <h2 id="faq-heading">Frequently asked questions</h2>
        <div class="section-underline" aria-hidden="true"></div>
      </div>
    </div>
    <dl class="home-faq-list">
      {faqs.map(faq => (
        <div class="home-faq-item" data-reveal>
          <dt>{faq.q}</dt>
          <dd>{faq.a}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
  }

  /* FAQ */
  .home-faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .home-faq-item {
    position: relative;
    padding: 24px;
    background: linear-gradient(180deg, var(--ink-3), var(--ink-2) 45%);
    border: 1px solid var(--ink-4);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    transition: border-color 220ms ease, transform 220ms ease;
    overflow: hidden;
  }
  .home-faq-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--copper), transparent);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .home-faq-item:hover {
    border-color: rgba(255, 107, 53, 0.35);
    transform: translateY(-2px);
  }
  .home-faq-item:hover::before {
    opacity: 1;
  }

  .home-faq-item dt {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    color: var(--parchment);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .home-faq-item dd {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--parchment-3);
  }

  @media (max-width: 767px) {
    .home-faq-list {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
